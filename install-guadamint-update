#!/bin/bash

# Comprobación de root para la INSTALACIÓN
if [ "$EUID" -ne 0 ]; then
  echo "Por favor, ejecuta el instalador como root (sudo ./install.sh)"
  exit 1
fi

echo ">>> Instalando sistema GuadaMint (Actualizador + Tienda + Toggle)..."

# 0. INSTALAR DEPENDENCIAS (GIT)
echo "Comprobando dependencias..."
if ! command -v git &> /dev/null; then
    echo "-> Git no encontrado. Intentando instalar..."
    apt-get update && apt-get install -y git
    if [ $? -ne 0 ]; then
        echo "¡AVISO! No se pudo instalar git vía apt. Se dependerá de los paquetes preinstalados."
    fi
fi

# 1. DEFINIR RUTAS DE ORIGEN Y DESTINO
SOURCE_DIR=$(dirname "$0")

DEST_BIN_UPDATE="/usr/bin/guadamint-update.py"  
DEST_BIN_STORE="/usr/bin/apps-guadamint.py"
DEST_BIN_TOGGLE="/usr/bin/guadamint-toggle-updates.py"

DEST_AUTOSTART_UPDATE="/etc/xdg/autostart/guadamint-update.desktop"
DEST_AUTOSTART_TOGGLE="/etc/xdg/autostart/guadamint-autoupdate-switch.desktop"
DEST_LAUNCHER_STORE="/usr/share/applications/apps-guadamint.desktop"

DEST_ICON="/usr/share/icons/guadamintuz.svg"
LOG_DIR="/var/log/guadamint"
OPT_DIR="/opt/guadamint"

# FUNCIÓN DE BÚSQUEDA INTELIGENTE
buscar_archivo() {
    local archivo=$1
    local subcarpeta=$2
    if [ -f "$SOURCE_DIR/$subcarpeta/$archivo" ]; then
        echo "$SOURCE_DIR/$subcarpeta/$archivo"
    elif [ -f "$SOURCE_DIR/$archivo" ]; then
        echo "$SOURCE_DIR/$archivo"
    else
        echo ""
    fi
}

# 2. CREAR ESTRUCTURA BASE EN /opt/guadamint Y COPIAR 'src' COMPLETO
echo "Creando directorios base en /opt/guadamint..."
mkdir -p "$OPT_DIR/images"
mkdir -p "$OPT_DIR/src"

if [ -d "$SOURCE_DIR/src" ]; then
    echo "Copiando todos los fuentes a $OPT_DIR/src/..."
    cp -r "$SOURCE_DIR/src/"* "$OPT_DIR/src/" 2>/dev/null
fi

if [ -d "$SOURCE_DIR/images" ]; then
    echo "Copiando imágenes iniciales a $OPT_DIR/images/..."
    cp -r "$SOURCE_DIR/images/"* "$OPT_DIR/images/" 2>/dev/null
fi

# 3. COMPROBACIÓN E INSTALACIÓN DE SUDOERS (ACTUALIZADOR Y TOGGLE)
# 3.1 Sudoers Actualizador
FILE_SUDOERS_UPDATE=$(buscar_archivo "zz-guadamint-update" "src")
if [ -n "$FILE_SUDOERS_UPDATE" ]; then
    cp "$FILE_SUDOERS_UPDATE" "/etc/sudoers.d/zz-guadamint-update"
    chown root:root "/etc/sudoers.d/zz-guadamint-update"
    chmod 0440 "/etc/sudoers.d/zz-guadamint-update"
    echo "-> Permisos sudoers (update) configurados."
fi

# 3.2 Sudoers Toggle
FILE_SUDOERS_TOGGLE=$(buscar_archivo "zz-guadamint-toggle-updates" "src")
if [ -n "$FILE_SUDOERS_TOGGLE" ]; then
    cp "$FILE_SUDOERS_TOGGLE" "/etc/sudoers.d/zz-guadamint-toggle-updates"
    chown root:root "/etc/sudoers.d/zz-guadamint-toggle-updates"
    chmod 0440 "/etc/sudoers.d/zz-guadamint-toggle-updates"
    echo "-> Permisos sudoers (toggle) configurados."
fi

# 4. INSTALAR EJECUTABLES EN /usr/bin/
# 4.1 Actualizador
FILE_UPDATE=$(buscar_archivo "guadamint-update.py" "src")
if [ -n "$FILE_UPDATE" ]; then
    cp "$FILE_UPDATE" "$DEST_BIN_UPDATE"
    chmod 755 "$DEST_BIN_UPDATE"
fi

# 4.2 Tienda
FILE_STORE=$(buscar_archivo "apps-guadamint.py" "src")
if [ -n "$FILE_STORE" ]; then
    cp "$FILE_STORE" "$DEST_BIN_STORE"
    chmod 755 "$DEST_BIN_STORE"
fi

# 4.3 Toggle
FILE_TOGGLE=$(buscar_archivo "guadamint-toggle-updates.py" "src")
if [ -n "$FILE_TOGGLE" ]; then
    cp "$FILE_TOGGLE" "$DEST_BIN_TOGGLE"
    chmod 755 "$DEST_BIN_TOGGLE"
    echo "-> Binario toggle instalado en /usr/bin/."
fi

# 5. INSTALAR AUTOARRANQUES Y LANZADORES (.desktop)
FILE_AUTOSTART_UPD=$(buscar_archivo "guadamint-update.desktop" "src")
if [ -n "$FILE_AUTOSTART_UPD" ]; then
    cp "$FILE_AUTOSTART_UPD" "$DEST_AUTOSTART_UPDATE"
    chmod 644 "$DEST_AUTOSTART_UPDATE"
fi

FILE_AUTOSTART_TOG=$(buscar_archivo "guadamint-autoupdate-switch.desktop" "src")
if [ -n "$FILE_AUTOSTART_TOG" ]; then
    cp "$FILE_AUTOSTART_TOG" "$DEST_AUTOSTART_TOGGLE"
    chmod 644 "$DEST_AUTOSTART_TOGGLE"
    echo "-> Autostart de toggle instalado."
fi

FILE_LAUNCHER_STORE=$(buscar_archivo "apps-guadamint.desktop" "src")
if [ -n "$FILE_LAUNCHER_STORE" ]; then
    cp "$FILE_LAUNCHER_STORE" "$DEST_LAUNCHER_STORE"
    chmod 644 "$DEST_LAUNCHER_STORE"
fi

# 6. INSTALAR ICONO
FILE_ICON=$(buscar_archivo "guadamintuz.svg" "images")
if [ -z "$FILE_ICON" ]; then FILE_ICON=$(buscar_archivo "AndaTuz2.svg" "images"); fi
if [ -n "$FILE_ICON" ]; then
    cp "$FILE_ICON" "$DEST_ICON"
    chmod 644 "$DEST_ICON"
fi

# 7. CARPETA DE LOGS CON PERMISOS DE ESCRITURA
mkdir -p "$LOG_DIR"
chmod 777 "$LOG_DIR"

echo ">>> Instalación completada con éxito."
